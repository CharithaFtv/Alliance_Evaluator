# Copy to .env (gitignored) and fill in. Never commit .env or key files.
SNOWFLAKE_ACCOUNT=YIRCHFV-ZD52396        # from your Snowflake URL: <org>-<account>
SNOWFLAKE_USER=                          # your Snowflake login name
SNOWFLAKE_ROLE=                          # your dev role
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_AUTH=externalbrowser           # externalbrowser (SSO, dev) | keypair (service user, hosted)
# keypair only; keep the key OUTSIDE the project folder:
# SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake_keys/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Corporate TLS-inspection CA bundle (PEM: public roots + corporate root); needed for large result downloads
# SNOWFLAKE_CA_BUNDLE=~/corp_ca_bundle.pem
